benchmark/staging/
benchmark/batch3_pilot/
benchmark/contract_v2/generated_tasks/
benchmark/contract_v2/generated_references/
# Hard-50 staging keeps complete upstream checkouts and frozen reference
# solutions locally.  The public repository carries task contracts and hashes;
# evaluator-only assets are delivered through a checksummed server overlay.
benchmark/hard50_pilot/_swapped_out/
benchmark/hard50_pilot/*/repo/
benchmark/hard50_pilot/*/*

# Python-200 holdout assets must not enter the public Git history before the
# frozen experiments complete.  They remain on disk and in the server overlay.
benchmark/hard50/*/hidden_tests/
benchmark/hard50/*/evaluation/oracle_manifest.json
benchmark/submissions/*
!benchmark/submissions/.gitkeep
!benchmark/submissions/go_dummy__adder_core__001/
!benchmark/submissions/go_dummy__adder_core__001/oracle/
!benchmark/submissions/go_dummy__adder_core__001/oracle/**

# Existing tracked wheels remain available for compatibility.  New wheels are
# delivered through the checksummed server overlay instead of growing Git.
benchmark/vendor-wheels/*.whl

# Experiment dump bundles. Nested agent workspaces often contain
# uninitialized .git (no HEAD); git then treats them as submodules and
# `git add .` fails with "does not have a commit checked out".
exports/*
!exports/*.README.md
!exports/*.sha256

# Suite logs; not part of the tracked source tree.
logs/

# Local result tarballs at repo root.
/*.tar.gz

# Runnable bundles are rebuilt locally; only checksums are tracked.
benchmark/*.tar.gz

# Replay trees used to gold-label token utility; regenerated locally.
artifacts/research_analysis/token_utility_phase1_work/
# Keep only the canonical candidate/freeze records in Git; intermediate
# content-addressed candidates remain local audit scratch.
artifacts/research_analysis/python200_prime/candidates/*.json
benchmark/tasks/**/repo/.git/

# Reproducible canonical source archives are rebuilt from registry revisions.
# Their checksums are tracked; the archive bytes remain a local/server cache.
benchmark/sources/archives/

# Local cross-version wheel cache; the Python-200 release tracks CPython 3.11,
# ABI3, and universal wheels only.
benchmark/vendor-wheels/*cp312*.whl
