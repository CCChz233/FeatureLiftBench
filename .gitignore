# Experiment dump bundles. Nested agent workspaces often contain
# uninitialized .git (no HEAD); git then treats them as submodules and
# `git add .` fails with "does not have a commit checked out".
exports/*
!exports/*.README.md
!exports/*.sha256

# Suite logs; not part of the tracked source tree.
logs/

# Local result tarballs at repo root.
/*.tar.gz

# Runnable bundles are rebuilt locally; only checksums are tracked.
benchmark/*.tar.gz

# Replay trees used to gold-label token utility; regenerated locally.
artifacts/research_analysis/token_utility_phase1_work/
benchmark/tasks/**/repo/.git/

# Reproducible canonical source archives are rebuilt from registry revisions.
# Their checksums are tracked; the archive bytes remain a local/server cache.
benchmark/sources/archives/

# Local cross-version wheel cache; the Python-200 release tracks CPython 3.11,
# ABI3, and universal wheels only.
benchmark/vendor-wheels/*cp312*.whl
