{
  "task_id": "anytree__tree_resolve_render_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "When nodes are linked through the `parent` constructor argument, iterating `PreOrderIter` from the root returns the root followed by its descendants in preorder."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "Given a tree and a `Resolver` configured for `name`, `get` resolves both root-qualified paths and child-relative paths to the existing node; requesting a missing child raises `ChildResolverError`, which is a `ResolverError`."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "For a tree, iterating `RenderTree` yields rows exposing `pre`, `fill`, and `node`, while `findall` returns a tuple of matching nodes in traversal order and returns an empty tuple when no node matches."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "When an existing node's `parent` attribute is assigned, that node appears in the new parent's `children` tuple and subsequent preorder traversal includes it beneath that parent."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes Node/Resolver/RenderTree/PreOrderIter/findall/ChildResolverError/ResolverError with the kinds listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "the submitted package does not import forbidden upstream packages: anytree."
    }
  ],
