{
  "task_id": "boolean_py__expr_simplify_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "Given a boolean expression containing symbols, conjunction, disjunction, and negation, `BooleanAlgebra.parse` builds an expression whose `simplify` method returns the equivalent canonical expression."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "Given a parsed expression and a mapping from an algebra `Symbol` to `TRUE`, `Expression.subs` replaces that symbol, and with `simplify=True` returns the simplified substituted expression."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "Simplifying expressions that differ only in commutative operand order produces equal results, while parsing an expression that ends with an operator raises `ParseError`."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "When the parsed expression negates the `TRUE` constant, calling `simplify` returns the algebra's `FALSE` constant."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes BooleanAlgebra/parse/ParseError/Symbol with the kinds listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "the submitted package does not import forbidden upstream packages: boolean."
    }
  ],
