{
  "task_id": "cacheout__ttl_policy_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "`Cache.set` stores a key/value pair, `get` returns the stored value while it is live, and `delete` returns 1 for a removed key after which `get` returns the configured default."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "Given an injected callable timer and a positive default TTL, a cached entry remains available before its deadline and is unavailable when the timer reaches the deadline."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "Calling `Cache.configure(ttl=...)` changes the default TTL used by entries stored afterward."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "When inserting beyond `LRUCache.maxsize`, the least recently accessed entry is evicted, and a successful `get` refreshes an entry's recency."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes the required task API paths `featurelifted.Cache`, `featurelifted.Cache.set`, `featurelifted.Cache.get`, `featurelifted.Cache.delete`, `featurelifted.Cache.configure`, and `featurelifted.LRUCache` with the kinds and callable signatures listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "the submitted package does not import forbidden upstream packages: cacheout."
    }
  ],
