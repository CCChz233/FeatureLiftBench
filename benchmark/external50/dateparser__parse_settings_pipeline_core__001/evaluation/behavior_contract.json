{
  "task_id": "dateparser__parse_settings_pipeline_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "Given ISO-formatted or English month-name input, `parse` returns the corresponding midnight `datetime`; when Spanish or French is explicitly selected, localized month-name input returns the corresponding date."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "When `Settings` supplies supported options, `parse` honors day-month-year ordering and a preference for past dates, and returns a timezone-aware value when UTC awareness and conversion are requested."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "Given localized Spanish or French date text and an en/es/fr candidate list, `detect_languages` returns a list of language shortcodes containing the matching language."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "Constructing `Settings` with a supported setting assigned a value of an invalid type raises `TypeError` before parsing."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes the required task API paths `featurelifted.parse`, `featurelifted.Settings`, `featurelifted.detect_languages` with the kinds and callable signatures listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "the submitted package does not import forbidden upstream packages: dateparser."
    }
  ],
