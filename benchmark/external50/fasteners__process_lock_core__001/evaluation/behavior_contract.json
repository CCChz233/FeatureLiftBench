{
  "task_id": "fasteners__process_lock_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "`InterProcessLock` accepts a filesystem path, acquires an available lock either through `acquire()` or as a context manager, and releases the lock through `release()` or context exit."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "After an acquired `InterProcessLock` is released, the same lock object can acquire that path again and returns `True`."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "`InterProcessLock.acquire(blocking=False)` returns `True` when the requested lock is currently free."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "`InterProcessLock` operates on a caller-provided local path without requiring the lock file to exist before acquisition."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes InterProcessLock with the kinds listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "the submitted package does not import forbidden upstream packages: fasteners."
    }
  ],
