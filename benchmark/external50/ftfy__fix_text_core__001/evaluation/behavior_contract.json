      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "`fix_text` accepts Unicode strings containing common encoding mojibake, including Latin-1 and punctuation corruption, and returns the repaired text."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "`fix_text` leaves already-correct plain ASCII text unchanged, including embedded newline characters."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "`fix_text` accepts an empty string and returns an empty string."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "`fix_text` accepts partially damaged or multiply encoded Unicode text and returns text that repairs or otherwise changes the damaged representation."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes fix_text with the kinds listed in this contract."
