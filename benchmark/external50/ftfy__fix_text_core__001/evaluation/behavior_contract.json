  "task_id": "ftfy__fix_text_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "text": "The extracted feature must support this observable behavior: fix_text repairs latin-1 mojibake and em-dash sequences. Required observable cases include fix latin1 mojibake; fix em dash mojibake."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "text": "The extracted feature must support this observable behavior: fix_text leaves plain ascii unchanged. Required observable cases include fix identity ascii; fix preserves newlines."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "text": "The extracted feature must support this observable behavior: fix_text handles empty and partially broken utf-8. Required observable cases include fix empty; fix double encoded utf8."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "text": "wcwidth is the only allowed third-party dependency for formatting helpers."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "text": "The package exposes fix_text with the kinds listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "text": "the submitted package does not import forbidden upstream packages: ftfy."
    }
  ],
