    "behaviors": [
      {
        "id": "B001",
        "text": "When a function decorated by `MemoryHuey.task()` is called, one task is enqueued; after `dequeue` and `execute`, the returned result handle's nonblocking `get` returns the function result."
      },
      {
        "id": "B002",
        "text": "A `crontab` schedule built with a step expression is callable and returns true only for matching datetimes; independently enqueued task calls retain their own arguments and results."
      },
      {
        "id": "B003",
        "text": "After one or more decorated task calls are queued, calling `flush` removes all pending work so `pending_count` returns zero."
      },
      {
        "id": "B004",
        "text": "Before a queued task is flushed or dequeued, `pending_count` reports at least one pending item."
      },
      {
        "id": "B005",
        "text": "The package exposes MemoryHuey and crontab with the kinds listed in this contract."
      },
      {
        "id": "B006",
        "text": "the submitted package does not import forbidden upstream packages: huey."
      }
    ],
