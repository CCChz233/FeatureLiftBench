{
  "task_id": "icalendar__component_roundtrip_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "When an `Event` with a summary and start value is added to a `Calendar`, serializing and parsing the calendar preserves the event and its summary."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "`Calendar.from_ical` accepts existing iCalendar text as well as serialized bytes, exposes calendar properties by key, and preserves event subcomponent order."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "When events include an end value or multiple summaries, a serialize/parse roundtrip retains the end property and all events in insertion order."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "Calling `Calendar.to_ical` returns bytes that can be passed directly to `Calendar.from_ical` to reconstruct the calendar."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes Calendar/Event/from_ical/to_ical with the kinds listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "the submitted package does not import forbidden upstream packages: icalendar."
    }
  ],
