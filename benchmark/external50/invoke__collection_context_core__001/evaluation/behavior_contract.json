{
  "task_id": "invoke__collection_context_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "When a `task`-decorated function is added to a `Collection`, retrieving it by name and calling it with a `Context` forwards positional and keyword arguments and returns the function result."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "Tasks accept context-compatible objects as their first argument; with `MockContext(run=True)`, a task may call `run` without launching a shell and the mock records that call."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "When a named child collection contains a task, the parent resolves and invokes that task through its dotted name, and an `UnexpectedExit` raised by a task propagates with that exception type."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "Using `Collection.__getitem__` with a direct task name or a dotted child-collection task name returns the corresponding callable task."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes task/Collection/Context/MockContext/UnexpectedExit with the kinds listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "the submitted package does not import forbidden upstream packages: invoke."
    }
  ],
