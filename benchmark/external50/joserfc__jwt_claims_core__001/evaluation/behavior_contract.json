{
  "task_id": "joserfc__jwt_claims_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "Given an octet key and an HS256 header, `jwt.encode` returns a token string and `jwt.decode` with the same key returns a token whose claims preserve the encoded subject or issuer value."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "`OctKey.import_key` accepts symmetric secret material and `OctKey.generate_key` creates a key of the requested bit size; either key can sign and verify an HS256 token."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "jwt.decode returns a token even when the exp claim is already expired; JWTClaimsRegistry.validate then raises ExpiredTokenError for that expired exp claim."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "Decoded tokens expose .claims mapping."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes jwt, jwt.encode, jwt.decode, jwt.Token, jwt.JWTClaimsRegistry, OctKey, and ExpiredTokenError with the kinds listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "the submitted package does not import forbidden upstream packages: joserfc."
    }
  ],
