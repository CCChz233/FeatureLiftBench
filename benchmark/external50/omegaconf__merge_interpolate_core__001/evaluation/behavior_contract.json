{
  "task_id": "omegaconf__merge_interpolate_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "OmegaConf.create builds attribute-accessible configuration trees; OmegaConf.merge combines mappings, OmegaConf.to_container(..., resolve=True) replaces ${key} interpolations with their values, and OmegaConf.select resolves dotted paths while returning its default for a missing path."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "`OmegaConf.is_missing` and `OmegaConf.is_config` classify missing and config nodes; after `OmegaConf.resolve(cfg)`, interpolated values are readable by attribute access on the resolved tree."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "Resolving a missing interpolation with OmegaConf.to_container(..., resolve=True) raises InterpolationResolutionError, and assigning an unknown key after OmegaConf.set_struct(cfg, True) raises a key-related exception such as ConfigKeyError."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "ListConfig merge replaces list values as upstream default merge semantics used in tests."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes the required OmegaConf methods and InterpolationResolutionError/ConfigKeyError with the kinds listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "the submitted package does not import forbidden upstream packages: omegaconf."
    }
  ],
