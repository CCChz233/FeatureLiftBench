{
  "task_id": "portalocker__file_lock_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "`Lock` accepts a local file path and yields a writable file handle from its context manager; `lock` and `unlock` acquire and release an advisory lock on an open file handle."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "`LOCK_EX`, `LOCK_SH`, and `LOCK_NB` are exposed as non-`None` lock flag constants."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "`Lock` accepts a numeric `timeout` argument and can acquire an available local file through the context-manager protocol."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "`LockException` is an exception type that subclasses `Exception`."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes Lock/lock/unlock/LOCK_EX/LockException with the kinds listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "the submitted package does not import forbidden upstream packages: portalocker."
    }
  ],
