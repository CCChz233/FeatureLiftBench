  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "Given bytes or a binary stream whose leading bytes match bundled metadata, the detector recognizes the format: `from_string` and `from_stream` return its extension and `magic_string` returns matching records."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "For a recognized signature or extension, MIME mode and `from_extension` return the associated MIME type."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "`magic_string` returns a non-empty ranked list of match records for recognized bytes, with the best match first and its `extension` attribute identifying the format."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "Calling `magic_string` with empty input raises `PureError` or `ValueError`."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes the required task API paths `featurelifted.from_string`, `featurelifted.from_stream`, `featurelifted.magic_string`, `featurelifted.from_extension`, and `featurelifted.PureError` with the kinds and callable signatures listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "the submitted package does not import forbidden upstream packages: puremagic."
    }
  ],
