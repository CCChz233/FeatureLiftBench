      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "text": "The extracted feature must support this observable behavior: TOTP.at/verify for fixed timestamps. Required observable cases include totp at verify; totp verify rejects wrong."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "text": "The extracted feature must support this observable behavior: HOTP.at/verify for counters. Required observable cases include hotp at verify; hotp counter increments."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "text": "The extracted feature must support this observable behavior: random_base32 generates base32 secrets with minimum length guard. Required observable cases include random base32; random base32 length guard."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "text": "Tests use at(timestamp) rather than now() to avoid time dependence."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "text": "The package exposes TOTP/HOTP/random_base32 with the kinds listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "text": "the submitted package does not import forbidden upstream packages: pyotp."
    }
