{
  "task_id": "pyotp__totp_hotp_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "`TOTP.at` accepts a fixed timestamp and returns its one-time password, while `TOTP.verify` returns `True` for the matching code at that timestamp."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "`HOTP.at` accepts an integer counter and returns its one-time password, `HOTP.verify` accepts that code and counter, and different counters produce different codes."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "`random_base32` returns a secret containing only uppercase Base32 alphabet characters, uses a length of 32 by default, and raises `ValueError` when a requested length is below the supported minimum."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "`TOTP.verify` returns `False` when given a non-matching code for a fixed timestamp."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes TOTP/HOTP/random_base32 with the kinds listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "the submitted package does not import forbidden upstream packages: pyotp."
    }
  ],
