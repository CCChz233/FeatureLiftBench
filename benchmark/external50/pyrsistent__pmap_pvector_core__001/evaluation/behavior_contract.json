{
  "task_id": "pyrsistent__pmap_pvector_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "`pmap` accepts an initial mapping, and `PMap.set(key, value)` returns a distinct map in which existing entries remain readable and the new entry is available through indexing or `get`, without adding that entry to the original map."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "`PVector.set(index, value)` returns a distinct vector with that position replaced while the original vector retains its previous sequence."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "`PVector.extend(iterable)` returns a vector containing the original sequence followed by the iterable's values."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "`PVector.append(value)` and the other vector update methods return distinct vectors and leave their input vectors unchanged."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes pmap/pvector/PMap/PVector with the kinds listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "the submitted package does not import forbidden upstream packages: pyrsistent."
    }
  ],
