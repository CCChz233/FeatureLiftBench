{
  "task_id": "python_json_logger__json_formatter_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "Given a logging.LogRecord and a format string naming `message` and `levelname`, JsonFormatter.format returns JSON text whose decoded object contains the rendered message and level name."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "Formatter configuration controls output fields: names selected by `fmt` are emitted, `rename_fields` moves a record field to the requested key and removes its old key, and `static_fields` adds the configured constant values."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "When `fmt` is `%(message)s %(name)s`, formatting a record named `worker` with message `boom` yields decoded JSON containing `{\"message\": \"boom\", \"name\": \"worker\"}`."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "Each call to JsonFormatter.format returns text that `json.loads` accepts as one JSON object for that record."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes JsonFormatter with the kinds listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "Scanning every Python file in the submitted package finds no `import pythonjsonlogger` or `from pythonjsonlogger ...` statement."
    }
  ],
