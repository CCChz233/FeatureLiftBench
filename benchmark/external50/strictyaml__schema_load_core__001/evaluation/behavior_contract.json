{
  "task_id": "strictyaml__schema_load_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "load parses YAML through Map, Seq, Str, Int, and Bool validators and exposes converted Python primitives through document.data, including absent Optional keys without inserting a value."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "Nested Seq(Map(...)) schemas convert every nested item, while a scalar that does not satisfy its validator, such as `x` for Int(), raises YAMLValidationError."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "Optional keys may be omitted from Map schemas, and MapPattern(Str(), Int()) converts arbitrary string keys with integer values into a Python dictionary."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "YAMLValidationError is a StrictYAMLError subclass."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes load and declared validators/errors with the kinds listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "the submitted package does not import forbidden upstream packages: strictyaml."
    }
  ],
