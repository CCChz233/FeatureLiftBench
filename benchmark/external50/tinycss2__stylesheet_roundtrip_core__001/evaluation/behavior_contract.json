{
  "task_id": "tinycss2__stylesheet_roundtrip_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "parse_stylesheet returns QualifiedRule nodes for qualified rules and AtRule nodes for at-rules; malformed CSS such as an unmatched `}` is represented by a ParseError node instead of raising an exception."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "Serializing nodes returned by parse_stylesheet produces CSS containing the original rule content, and an `@import` rule retains its `@import` keyword after parse/serialize round-trip."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "When parse_stylesheet is called with `skip_whitespace=True`, its top-level result contains no node whose type name ends with `WhitespaceToken`."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "Parsing a selector rule such as `h1.title{}` returns a QualifiedRule whose `prelude` attribute is non-empty."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes the required task API paths `featurelifted.parse_stylesheet`, `featurelifted.serialize`, `featurelifted.ast.QualifiedRule`, `featurelifted.ast.AtRule`, `featurelifted.ast.ParseError` with the kinds and callable signatures listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "Scanning every Python file in the submitted package finds no `import tinycss2` or `from tinycss2 ...` statement."
    }
  ],
