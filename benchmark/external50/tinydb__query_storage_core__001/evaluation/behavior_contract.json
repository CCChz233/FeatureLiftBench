{
  "task_id": "tinydb__query_storage_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "TinyDB insert and insert_multiple persist dictionary documents, all returns them, update changes matching documents, get retrieves a match, remove deletes matches, and truncate empties the default table."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "Query field paths support equality, exists(), matches(), and test() predicates, and predicate expressions compose with & and | to filter TinyDB.search results."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "MemoryStorage retains documents for an in-memory database lifetime, while JSONStorage persists inserted documents across close and reopen at the same filesystem path."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "Default table behavior matches upstream TinyDB for the frozen CRUD paths."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes the required task API paths `featurelifted.TinyDB`, `featurelifted.Query`, `featurelifted.JSONStorage`, `featurelifted.MemoryStorage` and TinyDB CRUD methods with the kinds and callable signatures listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "the submitted package does not import forbidden upstream packages: tinydb."
    }
  ],
