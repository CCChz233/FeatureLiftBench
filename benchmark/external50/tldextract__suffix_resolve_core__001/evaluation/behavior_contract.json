{
  "task_id": "tldextract__suffix_resolve_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "TLDExtract(suffix_list_urls=()) splits a URL into subdomain, domain, and public suffix fields, including multi-label suffixes such as co.uk."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "Extracting a bare host such as example.com returns an empty subdomain, domain `example`, and suffix `com`; the module-level extract(url) convenience function returns the same ExtractResult shape."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "For https://foo.bar.co.uk, joining ExtractResult.domain and ExtractResult.suffix yields the registered domain bar.co.uk."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "suffix_list_urls=() disables network suffix fetch."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes TLDExtract/extract/ExtractResult with the kinds listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "the submitted package does not import forbidden upstream packages: tldextract."
    }
  ],
