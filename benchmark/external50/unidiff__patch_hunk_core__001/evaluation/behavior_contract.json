{
  "task_id": "unidiff__patch_hunk_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "PatchSet parses unified-diff text into an ordered collection of PatchedFile objects whose path omits the a/ or b/ prefix and whose entries are Hunk objects; patches containing multiple files produce one PatchedFile per file."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "Iterating a Hunk yields line objects whose line_type equals LINE_TYPE_ADDED, LINE_TYPE_REMOVED, or LINE_TYPE_CONTEXT according to the unified-diff prefix and whose value retains the line content."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "PatchSet accepts consecutive file sections in one diff, but raises UnidiffParseError when a hunk body does not satisfy the source and target lengths declared by its header."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "PatchedFile exposes added/removed counts."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes PatchSet/PatchedFile/Hunk/UnidiffParseError/LINE_TYPE_* with the kinds listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "the submitted package does not import forbidden upstream packages: unidiff."
    }
  ],
