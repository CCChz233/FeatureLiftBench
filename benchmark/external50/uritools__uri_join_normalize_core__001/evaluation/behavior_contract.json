{
  "task_id": "uritools__uri_join_normalize_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "urisplit returns a SplitResult exposing `scheme`, `authority`, `path`, `query`, and `fragment`; uriunsplit reconstructs the original absolute URI, while splitting a relative path leaves its scheme empty and preserves the path."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "urijoin resolves `../b` against `https://example.com/a/` as `https://example.com/b`, and with `strict=True` an absolute reference replaces the base URI unchanged."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "urinorm removes `.` and `..` path segments and lowercases an uppercase URI scheme, so normalized output for an HTTP URI contains the collapsed path and begins with `http://`."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "uriencode percent-encodes non-ASCII UTF-8 text, producing text or ASCII bytes containing `%`, and uridecode accepts that result and restores the original Unicode string."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes the required task API paths `featurelifted.urisplit`, `featurelifted.uriunsplit`, `featurelifted.urijoin`, `featurelifted.urinorm`, `featurelifted.uriencode`, `featurelifted.uridecode`, `featurelifted.SplitResult` with the kinds and callable signatures listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "Scanning every Python file in the submitted package finds no `import uritools` or `from uritools ...` statement."
    }
  ],
