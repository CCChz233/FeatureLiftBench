    "behaviors": [
      {
        "id": "B001",
        "text": "After a FileSystemEventHandler is scheduled on a directory and Observer is started, creating a file causes the handler's on_created callback to receive an event whose `src_path` identifies that file; stop() followed by join(timeout=...) shuts the observer down."
      },
      {
        "id": "B002",
        "text": "While an Observer watches a temporary directory, creating, rewriting, and deleting a file dispatches filesystem events through FileSystemEventHandler.on_any_event, so the handler records at least one event from the change sequence."
      },
      {
        "id": "B003",
        "text": "FileCreatedEvent, FileModifiedEvent, and FileDeletedEvent are importable class objects that can identify the corresponding filesystem event categories."
      },
      {
        "id": "B004",
        "text": "Observer accepts a polling timeout, watches local filesystem state without network access, and detects changes made after start() within the bounded test wait."
      },
      {
        "id": "B005",
        "text": "The package exposes Observer/FileSystemEventHandler/FileCreatedEvent/FileModifiedEvent/FileDeletedEvent with the kinds listed in this contract."
      },
      {
        "id": "B006",
        "text": "Scanning every Python file in the submitted package finds no `import watchdog` or `from watchdog ...` statement."
      }
    ],
    "exclusions": [
      "inotify-specific flags",
      "watchmedo CLI",
      "original watchdog import at runtime"
    ],
