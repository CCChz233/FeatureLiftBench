        "kind": "function",
        "signature": "() -> type[BaseException]"
      }
    ],
    "optional_api": [],
    "behaviors": [
      {
        "id": "B001",
        "text": "`run` executes an async entrypoint. Tasks started with `TaskGroup.create_task(coro)` inside `async with create_task_group()` all complete before the context exits, and their side effects are visible afterwards."
      },
      {
        "id": "B002",
        "text": "Calling `cancel()` on an open task group cancels pending tasks so they observe the exception class returned by `get_cancelled_exc_class()`."
      },
      {
        "id": "B003",
        "text": "A `fail_after(seconds)` block whose body awaits `sleep` longer than that deadline raises `TimeoutError` when driven by `run`."
      },
      {
        "id": "B004",
        "text": "Task-group execution does not perform network name resolution or open sockets; cancellation and timeouts are local to the running event loop."
      },
      {
        "id": "B005",
        "text": "The package exposes `create_task_group`, `run`, `fail_after`, `sleep`, and `get_cancelled_exc_class` as listed in this contract."
      },
      {
        "id": "B006",
        "text": "The submitted package source does not import the forbidden upstream package `anyio`."
      }
    ],
    "exclusions": [
      "trio plus asyncio production servers",
      "real TCP/UNIX network clients",
      "runtime import of anyio"
    ],
    "forbidden": {
