  "public_spec": {
    "title": "TaskGroup create_task and cancel",
    "summary": "Build a standalone `featurelifted` package providing AnyIO-style task groups, cancellation, and timeout scopes driven by `run`, without network IO.",
    "required_api": [
      {
        "path": "featurelifted.create_task_group",
        "kind": "function",
