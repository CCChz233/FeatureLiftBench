{
  "task_id": "apispec__plugin_documenter_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "Calling `APISpec.path` with a path and operations records that path under `to_dict()['paths']`."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "Calling `spec.components.schema(name, schema)` records the named schema under `to_dict()['components']['schemas']`."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "When an `APISpec` is constructed with plugins, each plugin's `init_spec` runs during construction and receives that spec."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "A plugin `path_helper` may supply missing operations or rewrite the path string stored in the spec."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes `APISpec` and `BasePlugin` with construction, `path`, `to_dict`, `init_spec`, and `path_helper` as listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "The submitted package source does not import the forbidden upstream package `apispec`."
    }
  ],
