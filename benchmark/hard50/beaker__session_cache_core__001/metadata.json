    "behaviors": [
      {
        "id": "B001",
        "text": "A memory `Session` created with `use_cookies=False` stores values like a mapping; after `save()`, a second `Session` constructed with the same `id` can read those values."
      },
      {
        "id": "B002",
        "text": "`CacheManager(type='memory').get_cache(name)` supports `put` then `get` for the same key in that named namespace."
      },
      {
        "id": "B003",
        "text": "`CacheManager.cache` used as a decorator memoizes a function so a second call with the same arguments does not re-run the wrapped body."
      },
      {
        "id": "B004",
        "text": "Sessions with different ids do not share keys. The memory backend does not contact memcached."
      },
      {
        "id": "B005",
        "text": "The package exposes `Session`, `CacheManager`, and `MemoryNamespaceManager` as listed in this contract."
      },
      {
        "id": "B006",
        "text": "The submitted package source does not import the forbidden upstream package `beaker`."
      }
    ],
