  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "An `App` subclass whose `Meta.handlers` lists a `Controller` with an `@ex` command named in `Meta.argv` returns that command's result from `run()` after setup."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "A `post_setup` hook listed in `Meta.hooks` runs during setup and receives the application object."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "After setup, the application has an installed controller, and a second `@ex` command on the same controller is selected by changing `Meta.argv`."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "The package exposes `App`, `Controller`, and `ex` with construction, `setup`, and `run` as listed in this contract."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The submitted package source does not import the forbidden upstream package `cement`."
    }
  ],
