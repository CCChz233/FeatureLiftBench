    "behaviors": [
      {
        "id": "B001",
        "text": "After `set_broker` with a `StubBroker`, an `@actor` function's `send` enqueues a message on that in-process broker without contacting RabbitMQ or Redis."
      },
      {
        "id": "B002",
        "text": "Middleware registered with `StubBroker.add_middleware` runs `before_enqueue` then `after_enqueue` around `send`, receiving the actor name of the enqueued message."
      },
      {
        "id": "B003",
        "text": "`get_broker()` returns the broker previously installed with `set_broker`. An actor declared with `max_retries=0` stores that option on the actor."
      },
      {
        "id": "B004",
        "text": "The in-process stub path does not start a worker loop or open a network connection; enqueue is enough to observe send and middleware."
      },
      {
        "id": "B005",
        "text": "The package exposes `actor`, `StubBroker`, `Middleware`, `set_broker`, and `get_broker` as listed in this contract."
      },
      {
        "id": "B006",
        "text": "The submitted package source does not import the forbidden upstream package `dramatiq`."
      }
    ],
