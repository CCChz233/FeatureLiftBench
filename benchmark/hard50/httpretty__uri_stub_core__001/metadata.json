  "public_spec": {
    "title": "In-process URI stubs",
    "summary": "Build a standalone `featurelifted` package providing HTTPretty-style `enable`, `register_uri`, and `last_request` so HTTP clients are stubbed in-process without outbound network access.",
    "required_api": [
      {
        "path": "featurelifted.enable",
        "kind": "function",
        "signature": "(allow_net_connect=True, verbose=False)"
      },
      {
        "path": "featurelifted.disable",
        "kind": "function",
        "signature": "()"
      },
      {
        "path": "featurelifted.reset",
        "kind": "function",
        "signature": "()"
      },
      {
        "path": "featurelifted.register_uri",
        "kind": "function",
        "signature": "(method, uri, body=..., adding_headers=None, forcing_headers=None, status=200, ...)"
      },
      {
        "path": "featurelifted.last_request",
        "kind": "function",
        "signature": "()"
      },
      {
        "path": "featurelifted.GET",
        "kind": "constant"
      }
    ],
    "optional_api": [],
    "behaviors": [
      {
        "id": "B001",
        "text": "After `enable(allow_net_connect=False)` and `register_uri(GET, url, body=...)`, `urllib.request.urlopen(url)` returns that body with HTTP status 200."
      },
      {
        "id": "B002",
        "text": "`last_request()` after a stubbed GET exposes the intercepted request `path`, `method`, and `host` for that URI."
      },
      {
        "id": "B003",
        "text": "A stubbed GET whose URI includes `?q=...` records `last_request().querystring` as a mapping from that query key to a one-element list of the value."
      },
      {
        "id": "B004",
        "text": "Calling `reset()` while still enabled unregisters previously registered URIs so a later `urlopen` for that URI raises instead of returning the old stub body."
      },
      {
        "id": "B005",
        "text": "The package exposes `enable`, `disable`, `reset`, `register_uri`, `last_request`, and `GET` as listed in this contract."
      },
      {
        "id": "B006",
        "text": "The submitted package source does not import the forbidden upstream package `httpretty`."
      }
    ],
    "exclusions": [
      "real sockets",
      "http2",
      "outbound HTTP",
      "runtime import of httpretty"
    ],
    "forbidden": {
      "imports": [
        "httpretty"
      ],
      "paths": []
    }
  },
