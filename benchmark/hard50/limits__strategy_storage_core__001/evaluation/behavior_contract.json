{
  "task_id": "limits__strategy_storage_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "After `parse` builds a limit item, `FixedWindowRateLimiter.hit` against `MemoryStorage` returns True until the parsed amount is exhausted in that window, then False."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "After a window is exhausted, `get_window_stats` reports `remaining == 0` for the same identifiers."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "Hits for distinct identifier strings are counted independently against the same limiter and limit item."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "`MemoryStorage.incr` increases a key by the given amount and `get` returns 0 for a missing key and the stored count afterwards."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes `MemoryStorage`, `FixedWindowRateLimiter`, `parse`, `hit`, `get_window_stats`, `incr`, and `get` with the signatures listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "The submitted package source does not import the forbidden upstream package `limits`."
    }
  ],
