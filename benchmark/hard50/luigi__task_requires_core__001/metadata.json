    "optional_api": [],
    "behaviors": [
      {
        "id": "B001",
        "text": "Calling `build` with a task follows `requires` recursively through a single task or nested list, tuple, set, and dictionary containers, and each incomplete dependency runs before the task that requires it."
      },
      {
        "id": "B002",
        "text": "When two branches of a dependency graph require the same task object, a successful local build executes that shared task no more than once before completing both branches and their join."
      },
      {
        "id": "B003",
        "text": "`Task.complete()` returns whether every target from `output()` exists; a task with no outputs is incomplete, and already-complete tasks are skipped by `build`."
      },
      {
        "id": "B004",
        "text": "`LocalTarget(path)` exposes that path, reports file existence, creates missing parent directories when opened for writing, and supports text reads and writes through context managers."
      },
      {
        "id": "B005",
        "text": "A call to `build(..., local_scheduler=True, workers=1)` executes entirely in the current process without making HTTP requests or requiring a central scheduler and returns `True` after all requested tasks complete."
      },
      {
        "id": "B006",
        "text": "The `Task` lifecycle methods, `LocalTarget` methods and path attribute, and `build` function are exported with the callable shapes stated in the required API."
      },
      {
        "id": "B007",
        "text": "Runtime source inspection of the submitted Python files finds no import of the upstream `luigi` package."
      }
    ],
    "exclusions": [
      "parameters and command-line parsing",
