    "behaviors": [
      {
        "id": "B001",
        "text": "A dataclass mixing in `DataClassDictMixin` round-trips nested mixin dataclasses through `from_dict` and `to_dict`."
      },
      {
        "id": "B002",
        "text": "A field constructed with `field_options(alias=...)` is read from and, when `Config.serialize_by_alias` is true, written to that alias key rather than the Python field name."
      },
      {
        "id": "B003",
        "text": "When `Config.omit_none` is true, `to_dict` omits fields whose value is `None`."
      },
      {
        "id": "B004",
        "text": "`from_dict` raises `MissingField` when a required field is absent from the input mapping."
      },
      {
        "id": "B005",
        "text": "The package exposes `DataClassDictMixin`, `field_options`, `MissingField`, and `config.BaseConfig` with the callable paths listed in this contract."
      },
      {
        "id": "B006",
        "text": "The submitted package source does not import the forbidden upstream package `mashumaro`."
      }
    ],
