    "behaviors": [
      {
        "id": "B001",
        "text": "`parse(\"https://example.com/foo\")` returns `(b\"https\", b\"example.com\", 443, b\"/foo\")`; `parse(\"https://example.org/path\")` returns `(b\"https\", b\"example.org\", 443, b\"/path\")`."
      },
      {
        "id": "B002",
        "text": "`unparse(*parse(\"https://example.com/bar\"))` equals `b\"https://example.com/bar\"`."
      },
      {
        "id": "B003",
        "text": "`parse(\"http://127.0.0.1:8080/x\")` returns `(b\"http\", b\"127.0.0.1\", 8080, b\"/x\")`."
      },
      {
        "id": "B004",
        "text": "`parse(\"not-a-url\")` raises `ValueError`."
