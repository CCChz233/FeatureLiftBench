{
  "task_id": "oauthlib__grant_dispatch_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "Given a validator that accepts client `cid` and redirect `https://example.com/cb`, `create_authorization_response` for `response_type=code` returns HTTP 302 with a `code` query parameter on `Location`."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "Exchanging that authorization code with `grant_type=authorization_code` via `create_token_response` returns HTTP 200 and a body containing `access_token`."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "A token request whose `grant_type` is not `authorization_code` is rejected with HTTP 400 and `unsupported_grant_type` in the body."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "A token request with an unknown or already-exchanged authorization code is rejected with HTTP 400."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes `WebApplicationServer` and `RequestValidator` with authorization and token response methods listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "The submitted package source does not import the forbidden upstream package `oauthlib`."
    }
  ],
