{
  "task_id": "oslo_policy__enforcer_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "After `ConfigOpts` is initialized with `args=[]` and `register_default` installs `role:admin`, `enforce` returns True for credentials whose `roles` include `admin` and False otherwise."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "A registered rule of `@` authorizes empty credentials."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "When `do_raise=True` and the check fails, `enforce` raises `PolicyNotAuthorized` whose message includes the rule name."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "A `policy.yaml` beside a `--config-file` overrides a stricter registered default for the same rule name."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes `ConfigOpts`, `Enforcer`, `RuleDefault`, and `PolicyNotAuthorized` with the signatures listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "The submitted package source does not import the forbidden upstream package `oslo_policy`."
    }
  ],
