    "title": "YAML config load and normalize",
    "summary": "Build a standalone `featurelifted` package that loads and normalizes a pre-commit YAML config file without cloning repositories or installing languages.",
    "required_api": [
      {
        "path": "featurelifted.load_config",
        "kind": "function",
        "signature": "(filename: str) -> dict"
      },
      {
        "path": "featurelifted.InvalidConfigError",
        "kind": "exception"
      }
    ],
    "optional_api": [],
    "behaviors": [
      {
        "id": "B001",
        "text": "Loading a local-repo YAML config returns a dict whose first hook keeps the declared `id`, `language`, and `entry`, and fills `language_version` with `'default'` and `pass_filenames` with True when those keys are omitted."
      },
      {
        "id": "B002",
        "text": "Loading a config whose only content is `repos: []` yields `minimum_pre_commit_version` equal to `'0'`."
      },
      {
        "id": "B003",
        "text": "Loading YAML that does not match the config schema, including a local hook whose `entry` is not a string, raises `InvalidConfigError`."
      },
      {
        "id": "B004",
        "text": "A local hook whose language is `system` is normalized so that the loaded hook `language` is `unsupported`."
      },
      {
        "id": "B005",
        "text": "The package exposes `load_config` and `InvalidConfigError` with the callable signatures listed in this contract."
      },
      {
        "id": "B006",
        "text": "The submitted package source does not import the forbidden upstream package `pre_commit`."
      }
    ],
    "exclusions": [
      "git clone of repos",
      "language environment install",
      "hook execution",
      "runtime import of pre_commit"
    ],
