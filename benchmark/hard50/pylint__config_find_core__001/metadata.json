    "behaviors": [
      {
        "id": "B001",
        "text": "When the current working directory contains a `pylintrc` file, `find_default_config_files()` yields that path; when `PYLINTRC` points at an existing file, that path is also yielded."
      },
      {
        "id": "B002",
        "text": "After `load_default_plugins`, `is_message_enabled('unused-import')` is True, and `_parse_command_line_configuration(['--disable=unused-import'])` makes it False while leaving unrelated messages enabled."
      },
      {
        "id": "B003",
        "text": "Calling `_parse_configuration_file(['--disable=unused-import'])` after loading default plugins makes `is_message_enabled('unused-import')` False."
      },
      {
        "id": "B004",
        "text": "Parsing a configuration argument that is not a pylint option raises `UnrecognizedOptionError` whose `options` list contains the option name without the leading dashes."
      },
      {
        "id": "B005",
        "text": "The package exposes `find_default_config_files`, `PyLinter`, and `UnrecognizedOptionError` with the callable signatures listed in this contract."
      },
      {
        "id": "B006",
        "text": "The submitted package source does not import the forbidden upstream package `pylint`."
      }
    ],
