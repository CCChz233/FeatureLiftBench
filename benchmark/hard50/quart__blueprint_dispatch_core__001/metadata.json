    "behaviors": [
      {
        "id": "B001",
        "text": "After `@app.route(path)` registers an async view, `app.test_client().get(path)` returns status 200 and the view body."
      },
      {
        "id": "B002",
        "text": "After a `Blueprint` is registered with `url_prefix`, a GET to `{url_prefix}{rule}` returns status 200 and the blueprint view body."
      },
      {
        "id": "B003",
        "text": "A GET to a path that matches no registered rule returns status 404."
      },
      {
        "id": "B004",
        "text": "Two blueprints registered with different prefixes dispatch independently: each prefix serves its own rule, and a rule from one blueprint is not found under the other prefix."
      },
      {
