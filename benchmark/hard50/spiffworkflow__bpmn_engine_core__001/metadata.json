            "kind": "method",
            "signature": "(self, process_id, required=True)"
          }
        ]
      },
      {
        "path": "featurelifted.BpmnWorkflow",
        "kind": "class",
        "signature": "(spec)",
        "members": [
          {
            "path": "featurelifted.BpmnWorkflow.do_engine_steps",
            "kind": "method",
            "signature": "(self, will_complete_task=None, did_complete_task=None)"
          },
          {
            "path": "featurelifted.BpmnWorkflow.is_completed",
            "kind": "method",
            "signature": "(self) -> bool"
          },
          {
            "path": "featurelifted.BpmnWorkflow.data",
            "kind": "attribute"
          }
        ]
      }
    ],
    "optional_api": [],
    "behaviors": [
      {
        "id": "B001",
        "text": "`BpmnParser.add_bpmn_str` accepts an in-memory BPMN document and `get_spec(process_id)` returns the process with that id so it can be wrapped in `BpmnWorkflow`."
      },
      {
        "id": "B002",
        "text": "A process that is only a start event, a script task assigning `result = 1 + 2`, and an end event reaches a completed state after `do_engine_steps()`, and the workflow data contains `result` equal to 3."
      },
      {
        "id": "B003",
        "text": "A process whose next work is a user task is not completed after `do_engine_steps()` because that waiting task is not an automatic engine step."
      },
      {
        "id": "B004",
        "text": "The engine runs entirely in memory from the XML string; tests do not read `repo/` or contact a network service."
      },
      {
        "id": "B005",
        "text": "The package exposes `BpmnParser` and `BpmnWorkflow` with `add_bpmn_str`, `get_spec`, `do_engine_steps`, and `is_completed`."
      },
      {
        "id": "B006",
        "text": "The submitted package source does not import the forbidden upstream package `SpiffWorkflow`."
      }
    ],
    "exclusions": [
      "BPMN editor UI",
      "full DMN decision tables",
      "runtime import of SpiffWorkflow"
    ],
    "forbidden": {
