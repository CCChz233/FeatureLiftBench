    "behaviors": [
      {
        "id": "B001",
        "text": "When an async or synchronous callable is decorated with `broker.task`, it is registered under a task name and the returned decorated task remains directly callable."
      },
      {
        "id": "B002",
        "text": "Calling `await decorated_task.kiq(*args, **kwargs)` on a registered task schedules local in-memory execution and returns a task handle without requiring an external broker or service."
      },
      {
        "id": "B003",
        "text": "Calling `await handle.wait_result()` waits for completion and returns a result object whose `return_value` is the callable result; `await handle.is_ready()` is false before completion when execution is pending and true afterward."
      },
      {
        "id": "B004",
        "text": "Calling `await broker.wait_all()` waits for all currently scheduled in-memory tasks to finish, including both async and synchronous registered callables."
      },
      {
        "id": "B005",
        "text": "The package exposes `InMemoryBroker` and the task, handle, and result members listed in the required API contract."
      },
      {
        "id": "B006",
        "text": "The submitted package does not import the forbidden upstream package `taskiq` at runtime."
      }
    ],
