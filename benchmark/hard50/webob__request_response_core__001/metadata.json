          {
            "path": "featurelifted.Request.blank",
            "kind": "method",
            "signature": "(cls, path, environ=None, base_url=None, headers=None, POST=None, **kw)"
          }
        ]
      },
      {
        "path": "featurelifted.Response",
        "kind": "class",
        "signature": "(body=None, status=None, headerlist=None, app_iter=None, content_type=None, conditional_response=None, charset=..., **kw)",
        "members": [
          {
            "path": "featurelifted.Response.body",
            "kind": "attribute"
          },
          {
            "path": "featurelifted.Response.content_type",
            "kind": "attribute"
          },
          {
            "path": "featurelifted.Response.json_body",
            "kind": "attribute"
          },
          {
            "path": "featurelifted.Response.status_code",
            "kind": "attribute"
          }
        ]
      }
    ],
    "optional_api": [],
    "behaviors": [
      {
        "id": "B001",
        "text": "After `Request.blank(\"/search?q=lift\")`, `method` is GET, `path_info` is `/search`, and `GET[\"q\"]` is `lift`."
      },
      {
        "id": "B002",
        "text": "Headers passed to `Request.blank` are readable case-insensitively (`headers[\"X-Trace\"]` and `headers[\"x-trace\"]` return the same value) and appear as `HTTP_X_TRACE` on `environ`."
      },
      {
        "id": "B003",
        "text": "`Request.blank(\"/\", POST={\"name\": \"ada\"})` yields method POST and `POST[\"name\"] == \"ada\"`; the body contains the urlencoded field."
      },
      {
        "id": "B004",
        "text": "`Response(json={\"ok\": True})` has status 200, content type `application/json`, `json_body == {\"ok\": True}`, and compact UTF-8 body. A `status=404` JSON response reports `status_code == 404`."
      },
      {
        "id": "B005",
        "text": "The package exposes `Request`, classmethod `Request.blank`, and `Response` as listed in this contract."
      },
      {
        "id": "B006",
        "text": "The submitted package source does not import the forbidden upstream package `webob`."
      }
    ],
    "exclusions": [
