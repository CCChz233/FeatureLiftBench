  "public_spec": {
    "title": "WSGI Request and Response",
    "summary": "Build a standalone `featurelifted` package providing WebOb-style `Request` and `Response` over an in-memory WSGI environ, including `Request.blank`, case-insensitive headers, form POST, and JSON response bodies. Do not open network sockets or use an HTTP client.",
    "required_api": [
