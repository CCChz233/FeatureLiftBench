{
  "task_id": "zope_component__site_lookup_core__001",
  "public_clauses": [
    {
      "behavior_id": "B001",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B001",
      "text": "After `provideUtility` registers an object for an interface, `getUtility` for that interface returns the same object."
    },
    {
      "behavior_id": "B002",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B002",
      "text": "When no utility is registered for an interface, `queryUtility` returns the supplied default, or `None` when no default is given."
    },
    {
      "behavior_id": "B003",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B003",
      "text": "When no utility is registered for an interface, `getUtility` raises `ComponentLookupError`."
    },
    {
      "behavior_id": "B004",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B004",
      "text": "Utilities registered under different names for the same interface are returned independently by `getUtility(..., name=...)`."
    },
    {
      "behavior_id": "B005",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B005",
      "text": "The package exposes `getUtility`, `queryUtility`, `provideUtility`, `getGlobalSiteManager`, `implementer`, `Interface`, and `ComponentLookupError` with the signatures listed in this contract."
    },
    {
      "behavior_id": "B006",
      "clause_kind": "included_behavior",
      "spec_anchor": "metadata.json#/public_spec/behaviors/B006",
      "text": "The submitted package source does not import the forbidden upstream package `zope.component`."
    }
  ],
