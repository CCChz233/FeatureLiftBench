        "result": true,
        "error": null,
        "state": "c",
        "context": {},
        "log": [
          {
            "kind": "callback",
            "name": "pre",
            "event": "go",
            "state": "a"
          },
          {
            "kind": "callback",
            "name": "entered",
            "event": "go",
            "state": "b"
          },
          {
            "kind": "callback",
            "name": "nextpre",
            "event": "next",
            "state": "b"
          },
          {
            "kind": "callback",
            "name": "post",
            "event": "go",
            "state": "c"
          }
        ]
      }
    ]
