ARG PYTHON_BASE=python:3.11-slim
ARG GO_VERSION=1.22.5
FROM ${PYTHON_BASE}

ARG GO_VERSION=1.22.5
ARG TARGETARCH

WORKDIR /workspace

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/workspace/harness \
    PIP_NO_CACHE_DIR=1 \
    CGO_ENABLED=0 \
    PATH=/usr/local/go/bin:${PATH}

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && case "${TARGETARCH}" in amd64) go_arch=amd64 ;; arm64) go_arch=arm64 ;; *) echo "unsupported target arch: ${TARGETARCH}" >&2; exit 1 ;; esac \
    && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${go_arch}.tar.gz" \
       | tar -C /usr/local -xz \
    && rm -rf /var/lib/apt/lists/*

RUN pip install \
    "pytest==7.4.4" \
    "idna==3.7" \
    "multidict==6.0.4" \
    "propcache==0.4.1"

COPY benchmark/vendor-wheels /workspace/benchmark/vendor-wheels
COPY harness /workspace/harness

ENV PIP_FIND_LINKS=/workspace/benchmark/vendor-wheels

RUN pip install --no-index --find-links /workspace/benchmark/vendor-wheels \
    -r /workspace/harness/config/benchmark_requirements.lock

ENTRYPOINT ["python", "-B", "-m", "featureliftbench.cli"]
