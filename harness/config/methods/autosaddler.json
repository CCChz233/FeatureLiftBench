{
  "schema_version": "featureliftbench.method_release.v1",
  "release_id": "autosaddler-flb.prompt-pack.screening.1",
  "display_name": "AutoSaddler-FLB",
  "ablation_arm": "main",
  "method_label": "autosaddler",
  "cli_flag": null,
  "environment_flag": "FEATURELIFTBENCH_OPENHANDS_PROMPT_APPEND_FILE=<frozen-prompt-pack>",
  "description": "Prompt-only AutoSaddler V2 search over four OpenHands appendix components. Information boundary, agent runtime, and evaluator stay Official Main. Optimizer never sees Hidden tests, assertions, or reference solutions. Screening only until a frozen pack is evaluated on a pre-registered held-out split. Do not merge scores into the OpenHands paper table.",
  "agent_profiles": [
    "openhands_deepseek_v4_flash_main"
  ],
  "information_condition": {
    "source_context": "full_repository",
    "source_hints": false,
    "benchmark_tests_visible": false,
    "public_contract_source": "metadata.public_spec only",
    "evaluator_feedback_to_agent": false
  },
  "method": {
    "kind": "prompt_pack_optimizer",
    "mutable_components": [
      "repository_inspection",
      "implementation_strategy",
      "self_verification",
      "completion_and_recovery"
    ],
    "seed_sentinel": "__AUTOSADDLER_FLB_INACTIVE__",
    "openhands_max_steps": 120,
    "repair_rounds": 0,
    "prompt_style": "standard"
  },
  "integration": {
    "package": "integrations/autosaddler_featureliftbench",
    "pin": "integrations/autosaddler_featureliftbench/AUTOSADDLER_PIN.json",
    "optimize_entrypoint": "python -m autosaddler_featureliftbench.runner",
    "evaluate_entrypoint": "./scripts/run_benchmark.sh --method autosaddler"
  }
}
